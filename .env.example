# ====================================================================
# VotePulse Environment Configuration Template
# Copy this file to .env and replace placeholders with secure secrets
# ====================================================================

# Secret Keys for Flask Sessions and JWT Signing
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-me-to-a-secure-jwt-signing-key-in-production
JWT_EXPIRES_HOURS=24

# PostgreSQL Database Configuration
POSTGRES_DB=votepulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/votepulse

# Initial Administrator Seed Credentials
# NOTE: Required initial setup credentials for the college demonstration
INITIAL_ADMIN_USERNAME=brmovs
INITIAL_ADMIN_PHONE=7025919468
INITIAL_ADMIN_PASSWORD=qw1988ab1988
INITIAL_ADMIN_NAME=System Administrator

# Server Ports
PORT=5000
VITE_BACKEND_URL=http://127.0.0.1:5000
